# Public SPA config (not secrets) — the marketing site calls the API + Cognito
# directly. Copy to `.env` and fill for local dev. These values are baked into
# the static bundle at `npm run build` time, so they must be present before the
# marketing CDK deploy (see README).
VITE_API_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com
VITE_AWS_REGION=us-east-2
VITE_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
